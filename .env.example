# Copy this file to .env.local and fill in your own credentials.
# Restart the development server after changing .env.local.
# Keep real keys server-side: do not add a VITE_ prefix or commit them.

# Gemini: required for Scan & Learn and the older /api/pip-help route.
GEMINI_API_KEY=

# Optional model override shared by Scan & Learn and Pip Q&A.
# Leave blank to use each route's default model.
GEMINI_MODEL=
# Optional fallback order for image scans; current defaults are shown.
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-3.1-flash-lite

# Pip text chat and the older lesson Q&A route.
# Both need Tiger Data so one daily budget is shared across server instances.
PIP_HELP_ENABLED=true
PIP_TEXT_DAILY_LIMIT=25

# Nimble: optional related articles for image scans.
NIMBLE_API_KEY=
NIMBLE_SEARCH_URL=https://sdk.nimbleway.com/v2/search

# Tiger Data: required for scan storage, answer history, and the gallery.
# Use the connection values from your Tiger Data service.
TIGER_HOST=
TIGER_PORT=5432
TIGER_DB=
TIGER_USER=
TIGER_PASSWORD=

# Pip's site-wide text and voice conversation uses one private ElevenLabs Agent
# configured with a Gemini model. These values stay on the server.
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
# Voice stays off until you set this to true after setting provider limits.
PIP_AGENT_ENABLED=false
PIP_VOICE_DAILY_LIMIT=3
PIP_VOICE_MAX_SECONDS=120

# Pip's bundled greeting clips need no runtime ElevenLabs key.
